# StegoShield environment configuration
# Copy this file to .env and adjust values for your environment.
#
# Vercel deployment: set these as Project -> Settings -> Environment
# Variables (not in a committed file). Two values should differ from
# the local defaults below because of Vercel's serverless filesystem
# and request-size constraints - see README "Production Deployment":
#   UPLOAD_TEMP_DIR=/tmp/stegoshield
#   LOG_FILE=/tmp/stegoshield-logs/app.log
#   MAX_CONTENT_LENGTH_MB=2   (Vercel's platform request-body limit is ~4.5MB;
#                              2MB leaves headroom for the two-file
#                              image-analysis endpoint in one request)

# Flask
FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-value
DEBUG=False

# Server
HOST=127.0.0.1
PORT=5000

# Upload / processing limits
MAX_CONTENT_LENGTH_MB=10
MAX_IMAGE_DIMENSION=6000
ALLOWED_EXTENSIONS=png,bmp,jpg,jpeg

# Rate limiting (Flask-Limiter, in-memory storage by default)
RATE_LIMIT_DEFAULT=60 per minute
RATE_LIMIT_UPLOAD=10 per minute

# Paths
UPLOAD_TEMP_DIR=data/tmp
MODEL_PATH=ml/models/steganalysis_model.joblib
MODEL_METADATA_PATH=ml/models/model_metadata.json

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
